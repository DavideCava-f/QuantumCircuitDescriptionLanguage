/* Primo Programma, (Da debuggare)
let g : qbit -> qbit = \x : qbit. X(x) in
let m : ((qbit -> qbit) -> qbit) -> qbit = 
    \f : (qbit -> qbit). \x : qbit.
        let y : qbit = H(x) in
        let z : qbit = f y in
        H(z)
in
    m g q1


------------------------ Programma con decomp
let p: (qbit * qbit) = CNOT(q1,q2) in 

let <a,b> = p in 

CNOT(H(a),H(b))

------ AST
Let "p" ( TPair TQbit TQbit )
    ( Gate "CNOT"
        [ V
            ( Var "q1" )
        , V
            ( Var "q2" )
        ]
    )
    ( Decomp "a" "b"
        ( V
            ( Var "p" )
        )
        ( Gate "CNOT"
            [ Gate "H"
                [ V
                    ( Var "a" )
                ]
            , Gate "H"
                [ V
                    ( Var "b" )
                ]
            ]
        )
    )
----- TypedAST
TLet "p" ( TPair TQbit TQbit )
    ( TGate "CNOT"
        [ TV
            ( Var "q1" ) TQbit
        , TV
            ( Var "q2" ) TQbit
        ] ( TPair TQbit TQbit )
    )
    ( TDecomp "a" "b"
        ( TV
            ( Var "p" ) ( TPair TQbit TQbit )
        )
        ( TGate "CNOT"
            [ TGate "H"
                [ TV
                    ( Var "a" ) TQbit
                ] TQbit
            , TGate "H"
                [ TV
                    ( Var "b" ) TQbit
                ] TQbit
            ] ( TPair TQbit TQbit )
        ) ( TPair TQbit TQbit )
    ) ( TPair TQbit TQbit )

--------------------------- Programma con lambdas
let f : qbit -> qbit = \x : qbit .H(x) in X(f q2)

-----AST
Let "f" ( TFun TQbit TQbit )
    ( V
        ( Lambda "x" TQbit
            ( Gate "H"
                [ V
                    ( Var "x" )
                ]
            )
        )
    )
    ( Gate "X"
        [ App
            ( V
                ( Var "f" )
            )
            ( V
                ( Var "q2" )
            )
        ]
    )
----Typed AST
TLet "f" ( TFun TQbit TQbit )
    ( TV
        ( Lambda "x" TQbit
            ( Gate "H"
                [ V
                    ( Var "x" )
                ]
            )
        ) ( TFun TQbit TQbit )
    )
    ( TGate "X"
        [ TApp
            ( TV
                ( Var "f" ) ( TFun TQbit TQbit )
            )
            ( TV
                ( Var "q2" ) TQbit
            ) TQbit
        ] TQbit
    ) TQbit
