/* Primo Programma
\x: (qbit * qbit). let <y,z> = x in <z,y>

---AST
V
    ( Lambda "x" ( TPair TQbit TQbit )
        ( Decomp "y" "z"
            ( V
                ( Var "x" )
            )
            ( V
                ( Pair
                    ( V
                        ( Var "z" )
                    )
                    ( V
                        ( Var "y" )
                    )
                )
            )
        )
    )
------TypedAST
TV
    ( Lambda "x" ( TPair TQbit TQbit )
        ( Decomp "y" "z"
            ( V
                ( Var "x" )
            )
            ( V
                ( Pair
                    ( V
                        ( Var "z" )
                    )
                    ( V
                        ( Var "y" )
                    )
                )
            )
        )
    )
    ( TFun ( TPair TQbit TQbit ) ( TPair TQbit TQbit ) )







let g : qbit -> qbit = \a : qbit. X(a) in
let m : (qbit -> qbit) -> (qbit -> qbit) = 
    \f : qbit -> qbit. \x : qbit.
        let y : qbit = H(x) in
        let z : qbit = f y in
        H(z) 
in m g q1

Let "g" ( TFun TQbit TQbit )
    ( V
        ( Lambda "a" TQbit
            ( Gate "X"
                [ V
                    ( Var "a" )
                ]
            )
        )
    )
    ( Let "m"
        ( TFun ( TFun TQbit TQbit ) ( TFun TQbit TQbit ) )
        ( V
            ( Lambda "f" ( TFun TQbit TQbit )
                ( V
                    ( Lambda "x" TQbit
                        ( Let "y" TQbit
                            ( Gate "H"
                                [ V
                                    ( Var "x" )
                                ]
                            )
                            ( Let "z" TQbit
                                ( App
                                    ( V
                                        ( Var "f" )
                                    )
                                    ( V
                                        ( Var "y" )
                                    )
                                )
                                ( Gate "H"
                                    [ V
                                        ( Var "z" )
                                    ]
                                )
                            )
                        )
                    )
                )
            )
        )
        ( App
            ( App
                ( V
                    ( Var "m" )
                )
                ( V
                    ( Var "g" )
                )
            )
            ( V
                ( Var "q1" )
            )
        )
    )
TLet "g" ( TFun TQbit TQbit )
    ( TV
        ( Lambda "a" TQbit
            ( Gate "X"
                [ V
                    ( Var "a" )
                ]
            )
        ) ( TFun TQbit TQbit )
    )
    ( TLet "m"
        ( TFun ( TFun TQbit TQbit ) ( TFun TQbit TQbit ) )
        ( TV
            ( Lambda "f" ( TFun TQbit TQbit )
                ( V
                    ( Lambda "x" TQbit
                        ( Let "y" TQbit
                            ( Gate "H"
                                [ V
                                    ( Var "x" )
                                ]
                            )
                            ( Let "z" TQbit
                                ( App
                                    ( V
                                        ( Var "f" )
                                    )
                                    ( V
                                        ( Var "y" )
                                    )
                                )
                                ( Gate "H"
                                    [ V
                                        ( Var "z" )
                                    ]
                                )
                            )
                        )
                    )
                )
            )
            ( TFun ( TFun TQbit TQbit ) ( TFun TQbit TQbit ) )
        )
        ( TApp
            ( TApp
                ( TV
                    ( Var "m" )
                    ( TFun ( TFun TQbit TQbit ) ( TFun TQbit TQbit ) )
                )
                ( TV
                    ( Var "g" ) ( TFun TQbit TQbit )
                ) ( TFun TQbit TQbit )
            )
            ( TV
                ( Var "q1" ) TQbit
            ) TQbit
        ) TQbit
    ) TQbit


------------------------ Programma con decomp
let p: (qbit * qbit) = CNOT(q1,q2) in 

let <a,b> = p in 

CNOT(H(a),H(b))

------ AST
Let "p" ( TPair TQbit TQbit )
    ( Gate "CNOT"
        [ V
            ( Var "q1" )
        , V
            ( Var "q2" )
        ]
    )
    ( Decomp "a" "b"
        ( V
            ( Var "p" )
        )
        ( Gate "CNOT"
            [ Gate "H"
                [ V
                    ( Var "a" )
                ]
            , Gate "H"
                [ V
                    ( Var "b" )
                ]
            ]
        )
    )
----- TypedAST
TLet "p" ( TPair TQbit TQbit )
    ( TGate "CNOT"
        [ TV
            ( Var "q1" ) TQbit
        , TV
            ( Var "q2" ) TQbit
        ] ( TPair TQbit TQbit )
    )
    ( TDecomp "a" "b"
        ( TV
            ( Var "p" ) ( TPair TQbit TQbit )
        )
        ( TGate "CNOT"
            [ TGate "H"
                [ TV
                    ( Var "a" ) TQbit
                ] TQbit
            , TGate "H"
                [ TV
                    ( Var "b" ) TQbit
                ] TQbit
            ] ( TPair TQbit TQbit )
        ) ( TPair TQbit TQbit )
    ) ( TPair TQbit TQbit )

