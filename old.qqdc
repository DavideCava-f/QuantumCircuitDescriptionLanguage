/* Programs with graph
------ P1 
\y : (qbit * qbit).(let <z,x> = y in CNOT(x,z))

------ P1 AST
TV
    ( TLambda "y" ( TPair TQbit TQbit )
        ( TDecomp "z" "x"
            ( TV
                ( TVar "y" ( TPair TQbit TQbit ) ) ( TPair TQbit TQbit )
            )
            ( TGate "CNOT"
                [ TV
                    ( TVar "z" TQbit ) TQbit
                , TV
                    ( TVar "x" TQbit ) TQbit
                ] ( TPair TQbit TQbit )
            ) ( TPair TQbit TQbit )
        )
        ( TFun ( TPair TQbit TQbit ) ( TPair TQbit TQbit ) )
    )
    ( TFun ( TPair TQbit TQbit ) ( TPair TQbit TQbit ) )

------- P1 Graph
(Graph {nodes = fromList [(0,InPort "y"),(1,InPort "y"),(2,QGate "CNOT")], edges = [Edge (0,0) (2,0),Edge (1,0) (2,1)], nextID = 3},Pair (Single (2,0)) (Single (2,1)))
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

------ P2 
\y : qbit .let x : qbit = H(y) in X(x)

------ P2 AST

TV
    ( TLambda "y" TQbit
        ( TLet "x" TQbit
            ( TGate "H"
                [ TV
                    ( TVar "y" TQbit ) TQbit
                ] TQbit
            )
            ( TGate "X"
                [ TV
                    ( TVar "x" TQbit ) TQbit
                ] TQbit
            ) TQbit
        ) ( TFun TQbit TQbit )
    ) ( TFun TQbit TQbit )

------ P2 Graph
(Graph {nodes = fromList [(0,InPort "y"),(1,QGate "H"),(2,QGate "X")], edges = [Edge (0,0) (1,0),Edge (1,0) (2,0)], nextID = 3},Single (2,0))

----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
----- P3

\x: qbit.H(x)

---- P3 AST
TV
    ( TLambda "x" TQbit
        ( TGate "H"
            [ TV
                ( TVar "x" TQbit ) TQbit
            ] TQbit
        ) ( TFun TQbit TQbit )
    ) ( TFun TQbit TQbit )

------ P3 Graph

(Graph {nodes = fromList [(0,InPort "x"),(1,QGate "H")], edges = [Edge (0,0) (1,0)], nextID = 2},Single (1,0))

----------------------------------------------------------------------------------------------------------------------------------------------------------------

---- P4

\q1 : qbit.\q2 : qbit.let y : (qbit * qbit) = let x : qbit = H(q1) in CNOT(x,q2) in let <a,b> = y in H(a)

----- P4 AST

TV
    ( TLambda "q1" TQbit
        ( TV
            ( TLambda "q2" TQbit
                ( TLet "y" ( TPair TQbit TQbit )
                    ( TLet "x" TQbit
                        ( TGate "H"
                            [ TV
                                ( TVar "q1" TQbit ) TQbit
                            ] TQbit
                        )
                        ( TGate "CNOT"
                            [ TV
                                ( TVar "x" TQbit ) TQbit
                            , TV
                                ( TVar "q2" TQbit ) TQbit
                            ] ( TPair TQbit TQbit )
                        ) ( TPair TQbit TQbit )
                    )
                    ( TDecomp "a" "b"
                        ( TV
                            ( TVar "y" ( TPair TQbit TQbit ) ) ( TPair TQbit TQbit )
                        )
                        ( TGate "H"
                            [ TV
                                ( TVar "a" TQbit ) TQbit
                            ] TQbit
                        ) TQbit
                    ) TQbit
                ) ( TFun TQbit TQbit )
            ) ( TFun TQbit TQbit )
        )
        ( TFun TQbit ( TFun TQbit TQbit ) )
    )
    ( TFun TQbit ( TFun TQbit TQbit ) )

---- P4 Graph
(Graph {nodes = fromList [(0,InPort "q1"),(1,InPort "q2"),(2,QGate "H"),(3,QGate "CNOT"),(4,QGate "H")], edges = [Edge (0,0) (2,0),Edge (2,0) (3,0),Edge (1,0) (3,1),Edge (3,0) (4,0)], nextID = 5},Single (4,0))

