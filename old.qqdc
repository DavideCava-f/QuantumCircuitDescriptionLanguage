--------------------- P5 (Program with application)

---------------------- P5 AST
TV
    ( TLambda "q2" TQbit
        ( TLet "f" ( TFun TQbit TQbit )
            ( TV
                ( TLambda "x" TQbit
                    ( TGate "H"
                        [ TV
                            ( TVar "x" TQbit ) TQbit
                        ] TQbit
                    ) ( TFun TQbit TQbit )
                ) ( TFun TQbit TQbit )
            )
            ( TGate "X"
                [ TApp
                    ( TV
                        ( TVar "f" ( TFun TQbit TQbit ) ) ( TFun TQbit TQbit )
                    )
                    ( TV
                        ( TVar "q2" TQbit ) TQbit
                    ) TQbit
                ] TQbit
            ) TQbit
        ) ( TFun TQbit TQbit )
    ) ( TFun TQbit TQbit )

