-- GHCi script to inspect the intermediate stages of a compilation.
--
-- Run it from the project root in one of two ways:
--
--   cabal repl -v0 QuantumCircuitDescriptionLanguage < inspect.ghci
--
--   cabal repl QuantumCircuitDescriptionLanguage
--   ghci> :script inspect.ghci
--   ghci> ...keep exploring: ctx, ast, typed, c, root are all in scope
--
-- Change `file` below to inspect another program, and uncomment the sections
-- you want to see.

import DerivationZipper
import Control.Monad (foldM)
import qualified Text.Megaparsec as MP
import qualified Data.Map as Map

let file = "testFig7Paper.qqdc"

-- Stage 1: parse
src <- readFile file
let Right (ctx, ast) = MP.runParser mainParser "" src
putStrLn ("FILE: " ++ show src)

-- Stage 2: type
let Right (_, typed) = annotate ctx ast

-- Stage 3: derivation
let c = startDerivation (Map.fromList ctx) typed
let root = fromTree c

-- Stage 4: initial positions
:{
let (cfg, assoc) = addTokens (findInitials root) emptyConfig
    cfg1 = setupInitialTokens cfg
    go (finished, c) t = case runToken t c of
        Left err -> Left err
        Right (t',c') -> Right (finished ++ [t'], c')
:}
foldM go ([], cfg1 { cfgTokens = [] }) (cfgTokens cfg1)

------------------------------------------------------------------------------
-- Optional sections. Remove the leading `-- ` to enable one.
------------------------------------------------------------------------------

