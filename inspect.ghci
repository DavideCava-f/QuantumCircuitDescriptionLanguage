-- Step-by-step trace, pass by pass, with the same waiting rule as runMachine
:{
let waits toks t = case ruleAt (tokPos t) of
        Right (TGATE "CNOT" []) -> occPol (posOcc (tokPos t)) == N && tokenAtNode (tokPos t) toks < 2
        _                       -> False
    stepIO toks (done, cfg) t
      | stopCond (tokPos t) = return (done ++ [t], cfg)
      | waits toks t = putStrLn ("  WAIT  " ++ showPos (tokPos t) ++ " " ++ show (tokLabel t)) >> return (done ++ [t], cfg)
      | otherwise = case stepToken t cfg of
          Left err -> putStrLn ("  ERROR " ++ err) >> return (done ++ [t], cfg)
          Right (t', cfg') -> do
            putStrLn ("  " ++ showPos (tokPos t) ++ " " ++ show (tokLabel t)
                      ++ "  -->  " ++ showPos (tokPos t') ++ " " ++ show (tokLabel t'))
            return (done ++ [t'], cfg')
    passes n toks cfg
      | all (stopCond . tokPos) toks = return cfg
      | otherwise = do
          putStrLn ("---- pass " ++ show (n :: Int))
          (toks', cfg') <- foldM (stepIO toks) ([], cfg) toks
          if map tokPos toks' == map tokPos toks
            then putStrLn "  DEADLOCK" >> return cfg'
            else passes (n + 1) toks' cfg'
:}
cfgEnd <- passes 1 (cfgTokens cfg1) cfg1 { cfgTokens = [] }
-- print (cfgCircuit cfgEnd)


-- Final result, as printed by the program
:{
case (startMachine c) of
    Left err -> putStrLn ("ERROR: " ++ err)
    Right (final, assocList, finalList) -> do
        let wireNames = [ (lab, wireName p) | (p, lab) <- assocList ++ finalList ]
        printAsciiCircuit wireNames final
:}
